# ===== OurProjectBackend — משתני סביבה לפריסה בענן =====
# העתיקי את הקובץ הזה ל-.env מקומית, ומלאי את אותם ערכים
# בלוח הבקרה (Environment Variables) של שירות הענן.
# ⚠️ אף פעם לא מעלים את .env עצמו ל-Git.

# --- השרת ---
# הפורט שהשרת מאזין עליו. בענן השרות בדרך כלל מזריק PORT אוטומטית.
PORT=4000

# --- מסד נתונים (PostgreSQL) ---
# פרטי החיבור. בענן חייבים להצביע למסד מנוהל (Render / Neon / Supabase וכו').
DB_HOST=<host-of-postgres>
DB_PORT=5432
DB_NAME=edulinkdb
DB_USER=<db-user>
DB_PASS=<db-password>

# --- Cloudinary (אחסון קבצים/תמונות) ---
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# --- אופציונלי ---
# collation עברי לחיפוש/מיון נכון של טקסט עברי במסד.
# לדוגמה: he_IL.UTF-8  (השאירי ריק אם לא בטוחות)
PG_HEBREW_COLLATION=
